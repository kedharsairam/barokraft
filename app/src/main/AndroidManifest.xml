<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Two permissions, and neither is location.

      INTERNET is for the forecast. ACCESS_NETWORK_STATE is so the app can
      say "no connection, here is what the barometer can still tell you"
      instead of showing an error — the distinction is the whole point of
      this app, and it cannot be drawn without knowing whether the radio
      is up.

      There is deliberately NO location permission. The city is chosen by
      the user from a search list, never read from the device, so a
      weather app that tracks you is not something this app can become.
      On a phone with no barometer and no location grant, the offline path
      still works, because there is nothing to grant.

      There is no storage permission either. The pressure history is a
      small local file the app writes for itself, in its own directory.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The barometer is optional, and the app is built for its absence.

      A great many phones have no pressure sensor — every budget handset,
      most tablets, some laptops. Declaring it required="false" means those
      devices are not filtered out of the store and the app still installs
      and runs, in the network-only mode. Declaring it true would make
      this app uninstallable on hardware that is perfectly capable of
      showing a forecast.
    -->
    <uses-feature
        android:name="android.hardware.sensor.pressure"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BaroKraft">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BaroKraft"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
